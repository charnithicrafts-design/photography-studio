      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#F7F4ED",
          "name": "Chithramaya Off-White",
          "slug": "chitramaya-base-light"
        },
        {
          "color": "#FFFFFF",
          "name": "Chithramaya White",
          "slug": "chitramaya-pure-white"
        },
        {
          "color": "#171E4A",
          "name": "Chithramaya Navy",
          "slug": "chitramaya-text-dark"
        },
        {
          "color": "#35A248",
          "name": "Chithramaya Green",
          "slug": "chitramaya-accent-vibrant"
        },
        {
          "color": "#FAB417",
