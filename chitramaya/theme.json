          "slug": "chitramaya-yellow"
        },
        {
          "color": "#9B1C26",
          "name": "Chithramaya Red",
          "slug": "chitramaya-red"
        },
        {
          "color": "#E3DAC9",
          "name": "Thalam Studio Golden Light",
          "slug": "thalam-base-light"
        },
        {
          "color": "#1C1917",
          "name": "Thalam Charcoal",
          "slug": "thalam-text-dark"
        },
        {
